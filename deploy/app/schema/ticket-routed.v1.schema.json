{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-routed.v1.schema.json",
  "title": "TicketRouted v1",
  "description": "Published by the router component on topic tickets.routed; consumed by each queue's worker subscription.",
  "type": "object",
  "required": ["schema_version", "ticket_id", "queue", "confidence", "needs_human"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "ticket_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "queue": { "type": "string", "enum": ["billing", "technical", "account", "shipping"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_human": { "type": "boolean" }
  }
}
